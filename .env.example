# ===== 基础 =====
SENTINEL_ENV=dev
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
SENTINEL_TIMEZONE=Asia/Shanghai
# API 鉴权。留空则只允许 127.0.0.1 访问
SENTINEL_API_KEY=dev-key

# ===== 存储 =====
# 相对路径基于启动时的工作目录
SENTINEL_DATA_DIR=data

# ===== GitHub 数据源 =====
# fake   : 内置假数据，离线可跑（默认）
# replay : 回放 tests/fixtures 里录制的响应（尚未实现，会退回 fake）
# live   : 真实 GitHub API，必须配 token
SENTINEL_GITHUB_MODE=fake
SENTINEL_GITHUB_TOKEN=
SENTINEL_GITHUB_API_URL=https://api.github.com
SENTINEL_GITHUB_PER_PAGE=50
SENTINEL_GITHUB_MAX_PAGES=5
# 限流退避：等待时间超过 MAX_RETRY_WAIT 秒就直接失败，不让进程干等半小时
SENTINEL_GITHUB_RETRY_ATTEMPTS=3
SENTINEL_GITHUB_MAX_RETRY_WAIT=60

# ===== LLM =====
# mock          : 规则化模板摘要，零成本
# openai_compat : 任何兼容 /chat/completions 的服务（DeepSeek / Qwen / Ollama / OpenAI）
SENTINEL_LLM_PROVIDER=mock
SENTINEL_LLM_BASE_URL=https://api.deepseek.com/v1
SENTINEL_LLM_API_KEY=
# 当前官方模型名是 deepseek-flash；deepseek-chat / deepseek-reasoner 已进入下线计划
SENTINEL_LLM_MODEL=deepseek-flash
SENTINEL_LLM_TIMEOUT=60
SENTINEL_LLM_MAX_INPUT_CHARS=12000
SENTINEL_LLM_TEMPERATURE=0.2
# default: 不发 thinking 字段；disabled: 显式关闭思考（temperature 才生效）；enabled: 开启思考（不发 temperature）
SENTINEL_LLM_THINKING=disabled
SENTINEL_LLM_JSON_MODE=true
# 生成每日报告是长文，超时比摘要宽松
SENTINEL_LLM_REPORT_TIMEOUT=120

# ===== 每日进展 =====
# 留空则写 data/daily
SENTINEL_DAILY_DIR=
# 留空则沿用 SENTINEL_TIMEZONE；「当日」按这个时区切
SENTINEL_DAILY_TIMEZONE=
# 默认只出 issues/pulls；要带提交与发版就写 issues,pulls,commits,releases
SENTINEL_DAILY_RESOURCES=issues,pulls
SENTINEL_DAILY_MAX_ITEMS_PER_RESOURCE=200
SENTINEL_DAILY_BODY_EXCERPT_CHARS=160
SENTINEL_DAILY_SKIP_BOTS=true

# ===== 每日报告 =====
SENTINEL_REPORT_MAX_INPUT_CHARS=24000
SENTINEL_REPORT_MAX_OUTPUT_TOKENS=1600

# ===== 研发周期报告（v3.0）=====
# 区间跨度上限；超过一个季度基本取不全，宁可直接拒绝
SENTINEL_REPORT_RANGE_MAX_DAYS=92
# 区间模式单资源的翻页预算（per_page=50 时约 500 条）
SENTINEL_REPORT_RANGE_MAX_PAGES=10
# 区间报告的模型输入上限，明细比单日多得多
SENTINEL_REPORT_RANGE_MAX_INPUT_CHARS=32000

# ===== 通知 =====
# null : 只落库不发送（默认）; smtp : 邮件
SENTINEL_NOTIFY_CHANNEL=null
SENTINEL_SMTP_HOST=
SENTINEL_SMTP_PORT=465
SENTINEL_SMTP_USER=
SENTINEL_SMTP_PASSWORD=
SENTINEL_SMTP_FROM=
SENTINEL_SMTP_TO=
SENTINEL_SMTP_SSL=true
SENTINEL_SMTP_STARTTLS=false

# ===== 调度 =====
SENTINEL_ENABLE_SCHEDULER=true
SENTINEL_TICK_INTERVAL_SECONDS=60
SENTINEL_BOOTSTRAP_LOOKBACK_DAYS=7
SENTINEL_MAX_EVENTS_PER_REPORT=200
# 没有更新的周期是否也出报告（默认不出）
SENTINEL_EMIT_EMPTY_REPORTS=false
